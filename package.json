{
  "name": "dsh-plug-skills",
  "version": "0.1.3",
  "description": "DeepSeek Harness 的 Skills 管理器：在 设置 → 插件 → Skills 标签页中发现 GitHub 上的 Agent Skills 仓库（SKILL.md 技能包，topic:agent-skills / dsh-skill / claude-skills），查看详情后一键安装 / 移除。技能装入 $DSH_HOME/skills，skill-filesystem 热加载，无需重启。支持 GitHub 代理。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Casually/dsh-plug-skills.git"
  },
  "homepage": "https://github.com/Casually/dsh-plug-skills#readme",
  "bugs": {
    "url": "https://github.com/Casually/dsh-plug-skills/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "agent-skills",
    "skill-md",
    "marketplace"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
